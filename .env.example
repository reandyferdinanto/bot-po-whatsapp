# Security: Whitelist Authorized Numbers (e.g. 628123456789,628987654321). Leave empty to allow all.
ALLOWED_NUMBERS=

# PostgreSQL Database (Local VPS Cache & Fast Search)
PG_ENABLED=false
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=bot_po
PGSSL=false

# Cron Job Auto-Sync Google Sheets -> PostgreSQL
CRON_ENABLED=true
CRON_SYNC_SCHEDULE=*/30 * * * *

